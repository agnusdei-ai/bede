# Configure locally. No credentials are embedded in the bundle.
COMPOSE_PROFILES=local-db
SECRET_KEY=
MASTER_SECRET=
PARENT_PASSWORD=
CHILD_PIN=
POSTGRES_PASSWORD=
DATABASE_URL=
LICENSE_KEY=
LOCAL_LLM_BASE_URL=
LOCAL_LLM_MODEL=
BEDE_ADAPTER_ORDER=local
EDUCATOR_PILOT_ENABLED=false
EDUCATOR_INSTITUTION_EMAIL_DOMAIN=
EDUCATOR_BOOTSTRAP_EMAILS=
WEBAUTHN_RP_ID=localhost
WEBAUTHN_ORIGIN=https://localhost
WEBAUTHN_RP_NAME=Bede
ELEVATION_ENFORCED=true
LEGACY_TOKEN_GRACE=false

# Explicit opt-in for a second Mac over an approved private LAN.
BEDE_LAN_ENABLED=false
# BEDE_LAN_BIND_IP=192.168.1.50
# WEBAUTHN_RP_ID=bede-pilot.school.example.org
# WEBAUTHN_ORIGIN=https://bede-pilot.school.example.org
