        "word_bank": ["lentē", "rēmōs", "somnium", "vīta"],
        "items": [
          {"number": 1, "prompt": "Dūc, dūc, ___ dūc,", "student_response": "rēmōs",   "teacher_mark": "correct", "confidence": 0.9},
          {"number": 2, "prompt": "___ in aquā.",       "student_response": "lentē",   "teacher_mark": "correct", "confidence": 0.7, "ask_parent": "The handwritten n may read as h"},
          {"number": 3, "prompt": "Hilarē … ___ est",   "student_response": "somnium", "teacher_mark": "correct", "confidence": 0.9},
          {"number": 4, "prompt": "… est ___.",         "student_response": "vīta",    "teacher_mark": "correct", "confidence": 0.7, "ask_parent": "The macron on the i is unclear"}
        ]
      },
      {
        "label": "Part 3",
        "instructions": "Fill in the circle with the correct color.",
        "required_format": "color_fill",
        "items": [
          {"number": 1, "prompt": "Alba",  "student_response": "uncolored", "teacher_mark": "correct", "confidence": 0.9},
          {"number": 2, "prompt": "Fusca", "student_response": "brown",     "teacher_mark": "correct", "confidence": 0.95},
          {"number": 3, "prompt": "Flava", "student_response": "yellow",    "teacher_mark": "correct", "confidence": 0.95}
        ]
      }
    ]
  },

  "expected_teacher_mark_count": {"correct": 12, "total": 13, "source": "teacher_marks"},
  "expected_ask_parent_refs": ["Part 2 #2", "Part 2 #4"],

  "expected_diagnosis": {
