{
  "_fixture": "latin_quiz_1",
  "_note": "Hand-typed from a parent's two photos of a graded Latin quiz. The photos are deliberately NOT in this repository: they show a child's handwriting and a school's own worksheet. No name, school, teacher or date is recorded. The reading test against the real photos runs by hand (scripts/practice_golden_eval.py); everything below runs in CI.",

  "assessment": {
    "subject": "latin",
    "sections": [
      {
        "label": "Part 1",
        "instructions": "Using the word bank, answer in complete Latin sentences.",
        "required_format": "complete_sentence",
        "word_bank": ["canis", "fēlēs", "mūs", "avis", "anas", "natat", "currit", "edit", "bibit", "dormit", "volat", "est"],
        "items": [
          {"number": 1, "prompt": "Quid est?",  "stimulus": "picture: dog running",   "student_response": "canis",  "teacher_mark": "correct",   "confidence": 0.95},
          {"number": 2, "prompt": "Quid agit?", "stimulus": "picture: dog running",   "student_response": "currit", "teacher_mark": "correct",   "confidence": 0.95},
          {"number": 3, "prompt": "Quid est?",  "stimulus": "picture: bird flying",   "student_response": "avis",   "teacher_mark": "correct",   "confidence": 0.95},
          {"number": 4, "prompt": "Quid agit?", "stimulus": "picture: bird flying",   "student_response": "volat",  "teacher_mark": "correct",   "confidence": 0.95},
          {"number": 5, "prompt": "Quid est?",  "stimulus": "picture: duck on water", "student_response": "avis",   "teacher_mark": "incorrect", "teacher_correction": "anas", "confidence": 0.93},
          {"number": 6, "prompt": "Quid agit?", "stimulus": "picture: duck on water", "student_response": "natat",  "teacher_mark": "correct",   "confidence": 0.9}
        ]
      },
      {
        "label": "Part 2",
        "instructions": "Use the word bank to fill in the blanks.",
